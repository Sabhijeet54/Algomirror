---
/** Sanchay Technologies logo (the company's own artwork). `light` is the version for dark backgrounds. */
interface Props {
  height?: number;
  light?: boolean;
  class?: string;
}
const { height = 40, light = false, class: cls } = Astro.props;
const width = Math.round((height * 467) / 132);
---
<img
  class:list={['logo', cls]}
  src={light ? '/brand/logo-light.png' : '/brand/logo.png'}
  alt="Sanchay Technologies"
  width={width}
  height={height}
  decoding="async"
/>
