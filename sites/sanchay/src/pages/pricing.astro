---
import Base from '../layouts/Base.astro';
import { engagements, plans } from '../data/site';
---
<Base title="Pricing" description="Automated trading plans from ₹24,999 a month: Monthly, Quarterly, Half-yearly and Yearly. White label and custom development are quoted." current="/pricing/">
  <section class="page-hero wrap">
    <h1 class="page-title"><span data-intro>Pricing</span></h1>
    <p class="page-lead" data-intro>
      Four plans for traders, from one month to a full year. The longer the plan, the more indices, strategies and lots it covers.
    </p>
  </section>

  <section class="wrap plans-sec" aria-labelledby="plans-h">
    <h2 id="plans-h" class="sr-only">Trading plans</h2>
    <ul class="plans" data-reveal data-stagger>
      {
        plans.map((p) => (
          <li class:list={['plan', { 'plan--hot': p.id === 'HALF_YEARLY', 'plan--top': p.id === 'YEARLY' }]}>
            <div class="plan__head">
              <h3 class="plan__name">{p.name}</h3>
              {p.badge ? <p class="plan__badge">{p.badge}</p> : null}
            </div>
            <p class="plan__price">
              <span class="plan__cur">₹</span>
              <span class="plan__amt">{p.price}</span>
            </p>
            <p class="plan__per">{p.per}</p>
            <ul class="plan__keys">
              <li>{p.lots}</li>
              <li>{p.maintenance}</li>
            </ul>
            <ul class="plan__list">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a href={`/contact/?type=client&interest=TRADING_PLAN&plan=${p.id}`} class="btn plan__cta">
              <span class="roll" data-text={`Choose ${p.name}`}>
                <span>Choose {p.name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="plans__fine">
      Prices in Indian rupees. Brokerage, exchange charges and taxes on trades are separate and go to your broker. Fees are not
      refundable once a plan is activated; see the <a href="/refund-policy/">refund policy</a>.
    </p>
  </section>

  <section class="wrap biz" aria-labelledby="biz-h">
    <div class="biz__head">
      <h2 id="biz-h" class="h2" data-reveal>For businesses</h2>
      <p data-reveal>Brokers, advisors and firms get a quote made for their setup. Tell us what you run and we will send it.</p>
    </div>
    <div class="table" role="table" aria-label="Business engagements">
      <div class="table__row table__row--head" role="row">
        <span role="columnheader">Engagement</span>
        <span role="columnheader">For</span>
        <span role="columnheader">What you get</span>
        <span role="columnheader">Price</span>
      </div>
      {
        engagements.map((e) => (
          <div class="table__row" role="row" data-reveal>
            <span role="cell" class="table__name">{e.name}</span>
            <span role="cell">{e.who}</span>
            <span role="cell">{e.gets}</span>
            <span role="cell">
              <a href={e.href} class="lnk">Get a quote</a>
            </span>
          </div>
        ))
      }
    </div>
  </section>
</Base>
