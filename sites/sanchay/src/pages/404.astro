---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="nf wrap">
    <p class="nf__code" aria-hidden="true">REJECTED · 404</p>
    <h1 class="page-title">This order found no account.</h1>
    <p class="page-lead">The page you asked for does not exist or has moved.</p>
    <div class="hero__act">
      <a href="/" class="btn btn--lg"><span class="roll" data-text="Back to home"><span>Back to home</span></span></a>
      <a href="/contact/" class="lnk">Contact us</a>
    </div>
  </section>
</Base>
